        .chatbot-icon i { font-size:2.5rem; color:white; }
        .chatbot-icon:hover { transform:scale(1.1); background:#a5784a; }
        .chatbot-window { position:absolute; bottom:90px; right:0; width:350px; background:white; border-radius:20px; box-shadow:0 20px 40px rgba(0,0,0,0.15); overflow:hidden; display:none; }
        .chatbot-window.active { display:block; }
