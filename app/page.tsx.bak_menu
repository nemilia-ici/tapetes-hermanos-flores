            <button class="quick-btn" onclick="sendQuickMessage('agendar')">📅 Agendar cita</button>
            <button class="quick-btn" onclick="sendQuickMessage('horario')">⏰ Horario</button>
            <button class="quick-btn" onclick="sendQuickMessage('contacto')">📞 Contacto</button>
